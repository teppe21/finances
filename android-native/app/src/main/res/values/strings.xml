    <!-- About & Privacy -->
    <string name="about">About &amp; Privacy</string>
    <string name="version">Version: %1$s</string>
    <string name="about_desc">100% Offline-first native personal finance application. All financial data, receipt scans, and bank notifications are processed entirely on-device and never leave your phone.</string>
    <string name="privacy_title">Privacy &amp; Security Principles</string>
    <string name="privacy_body">1. No bank account passwords or credentials are ever requested or stored.\n2. Notification listener service only parses enabled banking notifications. Security codes, 2FA tokens, and personal messages are immediately discarded.\n3. Receipt images and OCR text stay on local storage only.\n4. No analytics, tracking, or cloud upload.</string>
